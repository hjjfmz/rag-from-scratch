# Chat and embeddings are OpenAI-compatible HTTP endpoints.
# Point them at OpenRouter, SiliconFlow, DashScope, DeepSeek, or a local Ollama server.
# Chat and embeddings can use different providers.

# [Required] First match wins: LLM_API_KEY, then OPENAI_API_KEY, then OPENROUTER_API_KEY.
LLM_API_KEY=your-api-key-here

# [Required endpoints]
CHAT_API_URL=https://api.siliconflow.cn/v1/chat/completions
EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings

# [Models] Names must exist on the endpoint above.
MODEL_CHAT=Qwen/Qwen2.5-7B-Instruct
MODEL_JUDGE=Qwen/Qwen2.5-7B-Instruct
MODEL_EMBEDDING=Qwen/Qwen3-Embedding-8B

# [Vector store] json = exact cosine in a local file. qdrant = HNSW adapter.
VECTOR_BACKEND=json
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_chunks

# [Optional] Only used by OpenRouter.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=rag-from-scratch
