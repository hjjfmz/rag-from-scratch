# -----------------------------------------------------------------------------
# OpenRouter-only configuration
# Fill these fields manually.
# -----------------------------------------------------------------------------

# [Required]
OPENROUTER_API_KEY=your-openrouter-api-key-here

# [Required endpoints]
CHAT_API_URL=https://openrouter.ai/api/v1/chat/completions
EMBEDDING_API_URL=https://openrouter.ai/api/v1/embeddings

# [Models]
MODEL_CHAT=qwen/qwen3-8b
MODEL_JUDGE=qwen/qwen3-8b
MODEL_EMBEDDING=qwen/qwen3-embedding-8b

# [Optional OpenRouter headers]
# Recommended by OpenRouter for usage attribution/routing
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=rag-from-scratch
