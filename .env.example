# Copy to .env in this project. Never commit keys.
# CLI accepts any OpenAI-compatible chat + embedding service.
# Fill model names supported by your selected service; chat and embeddings may use different providers.

# Generic key fallback: LLM_API_KEY -> OPENAI_API_KEY -> OPENROUTER_API_KEY
LLM_API_KEY=
# Independent keys take precedence if supplied:
CHAT_API_KEY=
EMBEDDING_API_KEY=

# Example OpenRouter endpoints/models; change all four for another provider.
CHAT_API_URL=https://openrouter.ai/api/v1/chat/completions
EMBEDDING_API_URL=https://openrouter.ai/api/v1/embeddings
MODEL_CHAT=qwen/qwen3-8b
MODEL_EMBEDDING=qwen/qwen3-embedding-8b

# Per-process request budgets. Maximum attempts = 1 + retries.
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
MODEL_MAX_CONCURRENCY=4
MODEL_REQUESTS_PER_SECOND=5
MODEL_EMBEDDING_BATCH_SIZE=64
MODEL_EMBEDDING_BATCH_CHARACTERS=24000

# Legacy Web configuration (Web has not migrated to the graph CLI):
OPENROUTER_API_KEY=
MODEL_JUDGE=qwen/qwen3-8b
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=local-knowledge

# ── Storage mode ─────────────────────────────────────────
# local    (default) SQLite adapter + in-process exact vector scan; no services needed
# services PostgreSQL + Qdrant + optional Redis; start them with `docker compose up -d`
RAG_STORAGE=local

# Data directory for the local SQLite store and the model cache
RAG_DATA_DIR=.runtime/knowledge

# 1 = offline heuristic models (no API key needed); empty = use the model config above
RAG_OFFLINE=1

# Service addresses (REQUIRED when RAG_STORAGE=services; missing values fail loudly)
# RAG_PG_DSN=postgresql://rag:rag_password@localhost:5432/rag
# RAG_QDRANT_URL=http://localhost:6333
# RAG_REDIS_URL=redis://localhost:6379/0
